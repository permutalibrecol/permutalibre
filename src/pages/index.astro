---
// LÓGICA DE SERVIDOR: Conexión oculta de tasas en la nube
let rawRate = 3950; 
try {
  const response = await fetch('https://binance.com');
  const data = await response.json();
  if (data.price) rawRate = parseFloat(data.price);
} catch (e) {}

// Tu margen personalizado del 2.5% ($50.000 por cada $2.000.000)
const feePercent = 2.5;
const effectiveRate = rawRate - (rawRate * (feePercent / 100));
---
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Permutalibre | Permuta de Inmuebles, Cripto y Efectivo RWA</title>
    <meta name="description" content="Portal oficial de Permutalibre. Permuta directa de inmuebles, liquidación de criptoactivos en efectivo y envíos internacionales a Venezuela y Costa Rica. Seguros, privados y sin P2P.">
    <link rel="stylesheet" href="https://cloudflare.com">
    <style>
        :root { 
            --brand-yellow: #facc15; 
            --brand-blue: #0f3460; 
            --brand-dark-bg: #090d16; 
            --brand-card: #131c2e; 
            --brand-cyan: #00d4ff; 
            --text-light: #f8fafc; 
        }
        * { margin:0; padding:0; box-sizing:border-box; scroll-behavior: smooth; }
        body { background: var(--brand-dark-bg); color: var(--text-light); font-family: -apple-system, system-ui, sans-serif; line-height: 1.5; }
        .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
        
        /* Navbar con tu identidad visual */
        header { background: var(--brand-blue); border-bottom: 4px solid var(--brand-yellow); padding: 1rem 0; position: sticky; top:0; z-index:100; box-shadow: 0 4px 15px rgba(0,0,0,0.4); }
        .nav-box { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; }
        .logo-container { display: flex; align-items: center; gap: 0.8rem; text-decoration: none; }
        .logo-img { height: 45px; width: auto; border-radius: 4px; object-fit: contain; }
        .logo-text { font-size: 1.6rem; font-weight: 900; color: var(--brand-yellow); text-shadow: 2px 2px 0px rgba(0,0,0,0.5); }
        nav { display: flex; gap: 1.2rem; }
        nav a { color: var(--text-light); text-decoration: none; font-size: 0.95rem; font-weight: bold; padding: 0.5rem; transition: 0.2s; }
        nav a:hover { color: var(--brand-yellow); }

        /* Banner Principal / Hero */
        .hero { padding: 4rem 0 3rem 0; text-align: center; }
        .hero h1 { font-size: 3rem; font-weight: 900; text-transform: uppercase; line-height: 1.2; margin-bottom: 1rem; color: var(--brand-yellow); text-shadow: 3px 3px 0px var(--brand-blue); }
        .hero p { font-size: 1.25rem; color: #cbd5e1; max-width: 750px; margin: 0 auto 2.5rem auto; font-weight: 500; }
        .badge { background: var(--brand-blue); border: 2px solid var(--brand-yellow); color: var(--brand-yellow); padding: 0.5rem 1.2rem; border-radius: 50px; font-size: 0.9rem; font-weight: bold; display: inline-block; margin-bottom: 1.5rem; box-shadow: 0 4px 10px rgba(0,0,0,0.2); }

        /* Tarjetas de Soluciones */
        .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-bottom: 5rem; }
        .card { background: var(--brand-card); border: 2px solid var(--brand-blue); border-radius: 16px; padding: 2.2rem; box-shadow: 0 10px 25px rgba(0,0,0,0.4); transition: 0.3s; }
        .card:hover { border-color: var(--brand-yellow); transform: translateY(-4px); }
        .card i { font-size: 2.8rem; color: var(--brand-yellow); margin-bottom: 1.2rem; text-shadow: 2px 2px 0px rgba(0,0,0,0.3); }
        .card h3 { font-size: 1.45rem; margin-bottom: 0.6rem; color: var(--brand-yellow); }
        .card p { color: #94a3b8; font-size: 1rem; line-height: 1.6; }

        /* Bloque Manifiesto Negocio Directo */
        .manifesto { background: linear-gradient(135deg, var(--brand-blue) 0%, #090d16 100%); border-left: 6px solid var(--brand-yellow); padding: 2.5rem; border-radius: 12px; margin-bottom: 5rem; box-shadow: 0 10px 20px rgba(0,0,0,0.3); }
        .manifesto h2 { color: var(--brand-yellow); margin-bottom: 1rem; font-size: 1.8rem; }
        .manifesto ul { list-style: none; text-align: left; max-width: 650px; margin: 0 auto; }
        .manifesto li { margin-bottom: 1rem; font-size: 1.1rem; line-height: 1.5; }
        .manifesto li i { color: #f43f5e; margin-right: 0.6rem; font-size: 1.2rem; }

        /* Formulario Inmobiliario Profesional */
        .form-section { background: var(--brand-card); border: 2px solid var(--brand-blue); border-radius: 20px; padding: 3rem 2rem; text-align: left; max-width: 700px; margin: 0 auto 6rem auto; box-shadow: 0 15px 35px rgba(0,0,0,0.5); }
        .form-section h2 { text-align: center; color: var(--brand-yellow); margin-bottom: 2rem; font-size: 2rem; text-transform: uppercase; }
        .form-group { margin-bottom: 1.5rem; }
        .form-group label { display: block; font-size: 0.95rem; font-weight: bold; margin-bottom: 0.5rem; color: #cbd5e1; }
        .form-group input, .form-group textarea { width: 100%; padding: 0.9rem; border-radius: 8px; border: 2px solid var(--brand-blue); background: #090d16; color: white; font-size: 1rem; transition: 0.2s; }
        .form-group input:focus, .form-group textarea:focus { border-color: var(--brand-yellow); outline: none; box-shadow: 0 0 10px rgba(250,204,21,0.2); }
        .btn-submit { display: block; width: 100%; background: var(--brand-yellow); color: var(--brand-blue); font-weight: 900; text-align: center; padding: 1.1rem; border-radius: 8px; border: none; font-size: 1.2rem; cursor: pointer; text-transform: uppercase; box-shadow: 0 4px 20px rgba(250,204,21,0.4); transition: 0.2s; }
        .btn-submit:hover { transform: scale(1.02); background: #fff; color: #000; }

        /* Botón Flotante de WhatsApp oficial de tu Marca */
        .whatsapp-float { position: fixed; bottom: 20px; right: 20px; background: #25d366; color: white; width: 60px; height: 60px; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 30px; box-shadow: 2px 2px 10px rgba(0,0,0,0.3); z-index: 1000; text-decoration: none; transition: 0.2s; }
        .whatsapp-float:hover { transform: scale(1.1); background: #20ba5a; }

        footer { background: #05070f; text-align: center; padding: 3rem 0; color: #64748b; font-size: 0.95rem; border-top: 2px solid var(--brand-blue); }

        @media (max-width: 768px) {
            .hero h1 { font-size: 2.2rem; }
            nav { justify-content: center; width: 100%; margin-top: 1rem; gap: 0.5rem; }
            .nav-box { justify-content: center; text-align: center; }
        }
    </style>
</head>
<body>

    <!-- Botón Flotante de WhatsApp para Conversiones Instantáneas Móviles -->
    <a href="https://wa.me" class="whatsapp-float" target="_blank">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

    <header>
        <div class="container nav-box">
            <!-- Espacio Vinculado para tu Logo e Identidad -->
            <a href="#" class="logo-container">
                <img src="/permutalibre/logo-marca.png" alt="Logo" class="logo-img" onerror="this.style.display='none';" />
                <span class="logo-text">PERMUTALIBRE</span>
            </a>
            <nav>
                <a href="#soluciones">Soluciones</a>
                <a href="#manifiesto">Por qué elegirnos</a>
                <a href="#registro">Registrar Bien</a>
            </nav>
        </div>
    </header>

    <main class="container">
        
        <section class="hero">
            <span class="badge"><i class="fa-solid fa-shield-halved"></i> Negociación Patrimonial Blindada</span>
            <h1>No lo vendas, cámbialo</h1>
            <p>Convertimos tus activos digitales en patrimonio real. Liquidación inmediata en efectivo físico, pasarelas de flujo transnacionales y permutas de inmuebles con intermediación jurídica ante constructoras.</p>
        </section>

        <section id="soluciones" class="services-grid">
            <div class="card">
                <i class="fa-solid fa-money-bill-wave"></i>
                <h3>Efectivo Físico Directo</h3>
                <p>Evita el rastreo bancario y congelamientos del P2P tradicional. Liquidamos tu capital directamente en efectivo con una tasa neta y transparente de <strong>${Math.round(effectiveRate).toLocaleString('es-CO')} COP</strong> por USDT.</p>
            </div>
            <div class="card">
                <i class="fa-solid fa-earth-americas"></i>
                <h3>Pasarelas Costa Rica & Venezuela</h3>
                <p>Moviliza flujos de dinero de forma privada y directa entre fronteras estratégicas. Diseñado para operaciones comerciales con tasas preferenciales competitivas.</p>
            </div>
            <div class="card">
                <i class="fa-solid fa-building-shield"></i>
                <h3>Propiedades por Cripto (RWA)</h3>
                <p>Intermediación corporativa estructurada ante constructoras. Adquiere bienes raíces de proyectos sobre planos o terminados usando cripto bajo contratos de fiducia legal.</p>
            </div>
        </section>

        <section id="manifiesto" class="manifesto">
            <h2>Por qué somos la evolución del P2P de Binance</h2>
            <p style="color:#cbd5e1; margin-bottom:1.5rem; font-weight: 500;">El ecosistema P2P se ha vuelto altamente riesgoso debido a fiscalizaciones masivas de la DIAN y fraudes. Nosotros eliminamos el riesgo financiero:</p>
            <ul>
                <li><i class="fa-solid fa-circle-xmark"></i> <strong>Cero estafas de triangulación:</strong> Eliminamos las cuentas de terceros desconocidos que congelan tus fondos.</li>
                <li><i class="fa-solid fa-circle-xmark"></i> <strong>Sin alertas bancarias automáticas:</strong> La gestión en efectivo físico resguarda tu privacidad patrimonial y fiscal.</li>
                <li><i class="fa-solid fa-circle-xmark"></i> <strong>Operaciones Patrimoniales de Gran Volumen:</strong> El ecosistema ideal para inversionistas serios que requieren mover capital sin fricciones.</li>
            </ul>
        </section>

        <section id="registro" class="form-section">
            <h2>🏠 Registro de Permuta Inmobiliaria</h2>
            <p style="color:#94a3b8; text-align:center; margin-bottom:2rem; font-size:1rem;">¿No cuentas con liquidez pero deseas cambiar un bien? Agrégalo a nuestra base privada para cruzar ofertas con inversionistas de capital.</p>
            
            <form action="https://wa.me" method="GET" target="_blank">
                <div class="form-group">
                    <label>Tipo de Bien y Ubicación</label>
                    <input type="text" name="tipo" placeholder="Ej: Apartamento en Cedritos, Bogotá" required />
                </div>
                <div class="form-group">
                    <label>Valor Comercial Estimado (COP)</label>
                    <input type="text" name="valor" placeholder="Ej: $450,000,000 COP" required />
                </div>
                <div class="form-group">
                    <label>¿Qué buscas a cambio en permuta? (USDT, Cripto u otros bienes)</label>
                    <textarea name="motivo" rows="3" placeholder="Ej: Busco USDT o propiedad de menor valor en el eje cafetero" required></textarea>
                </div>
                <div class="form-group">
                    <label>Registro Fotográfico</label>
                    <input type="text" readonly placeholder="📸 Adjunta las 5 fotografías directo a tu asesor al enviar este formulario" style="border-style:dashed; color:#94a3b8; cursor:not-allowed;" />
                </div>
                
                <button type="submit" class="btn-submit">Enviar Oferta de Permuta</button>
            </form>
        </section>

    </main>

    <footer>
        <div class="container">
            <p>&copy; 2026 Permutalibre Global S.A.S. Infraestructura de activos del mundo real (RWA) e intermediación financiera.</p>
        </div>
    </footer>

</body>
</html>
