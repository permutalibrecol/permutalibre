---
// LÓGICA DE SERVIDOR: Conexión oculta de tasas en la nube (el usuario no ve la palabra Binance)
let rawRate = 3950; 
try {
  const response = await fetch('https://binance.com');
  const data = await response.json();
  if (data.price) rawRate = parseFloat(data.price);
} catch (e) {}

// Comisión fija del 2.5% invertida a tu favor para operaciones en efectivo
const feePercent = 2.5;
const effectiveRate = rawRate - (rawRate * (feePercent / 100));
---
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Permutalibre | Permuta de Inmuebles, Cripto y Efectivo RWA</title>
    <meta name="description" content="Portal oficial de Permutalibre. Permuta directa de inmuebles, liquidación de criptoactivos en efectivo y envíos internacionales a Venezuela y Costa Rica. Seguros, privados y sin P2P.">
    <link rel="stylesheet" href="https://cloudflare.com">
    <style>
        :root { --gold: #facc15; --bg: #090d16; --card: #131c2e; --cyan: #00d4ff; --text: #f8fafc; }
        * { margin:0; padding:0; box-sizing:border-box; scroll-behavior: smooth; }
        body { background: var(--bg); color: var(--text); font-family: -apple-system, system-ui, sans-serif; line-height: 1.5; }
        .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
        
        /* Navbar */
        header { background: rgba(19, 28, 46, 0.95); border-bottom: 2px solid var(--gold); padding: 1rem 0; position: sticky; top:0; z-index:100; backdrop-filter:blur(10px); }
        .nav-box { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; }
        .logo { font-size: 1.5rem; font-weight: 900; color: var(--gold); text-decoration: none; }
        nav { display: flex; gap: 1.2rem; }
        nav a { color: var(--text); text-decoration: none; font-size: 0.9rem; font-weight: 600; }
        nav a:hover { color: var(--cyan); }

        /* Hero */
        .hero { padding: 5rem 0 3rem 0; text-align: center; }
        .hero h1 { font-size: 2.8rem; font-weight: 900; text-transform: uppercase; line-height: 1.2; margin-bottom: 1rem; color: var(--gold); }
        .hero p { font-size: 1.2rem; color: #94a3b8; max-width: 750px; margin: 0 auto 2.5rem auto; }
        .badge { background: rgba(0, 212, 255, 0.1); border: 1px solid var(--cyan); color: var(--cyan); padding: 0.4rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: bold; display: inline-block; margin-bottom: 1rem; }

        /* Grid de Servicios */
        .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-bottom: 5rem; }
        .card { background: var(--card); border: 1px solid #22314d; border-radius: 16px; padding: 2rem; box-shadow: 0 10px 20px rgba(0,0,0,0.3); transition: 0.3s; }
        .card:hover { border-color: var(--gold); transform: translateY(-3px); }
        .card i { font-size: 2.5rem; color: var(--gold); margin-bottom: 1rem; }
        .card h3 { font-size: 1.4rem; margin-bottom: 0.5rem; color: var(--cyan); }
        .card p { color: #94a3b8; font-size: 0.95rem; }

        /* Manifiesto Antidote P2P */
        .manifesto { background: linear-gradient(135deg, #131c2e 0%, #090d16 100%); border-left: 5px solid var(--gold); padding: 2.5rem; border-radius: 12px; margin-bottom: 5rem; }
        .manifesto h2 { color: var(--gold); margin-bottom: 1rem; }
        .manifesto ul { list-style: none; text-align: left; max-width: 600px; margin: 0 auto; }
        .manifesto li { margin-bottom: 0.8rem; font-size: 1.05rem; }
        .manifesto li i { color: #f43f5e; margin-right: 0.5rem; }

        /* Formulario de Registro de Bienes (Permuta Directa) */
        .form-section { background: var(--card); border: 1px solid #22314d; border-radius: 20px; padding: 3rem 2rem; text-align: left; max-width: 700px; margin: 0 auto 6rem auto; }
        .form-section h2 { text-align: center; color: var(--gold); margin-bottom: 2rem; }
        .form-group { margin-bottom: 1.5rem; }
        .form-group label { display: block; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.5rem; color: #cbd5e1; }
        .form-group input, .form-group textarea, .form-group select { width: 100%; padding: 0.8rem; border-radius: 8px; border: 2px solid #22314d; background: #090d16; color: white; font-size: 1rem; }
        .form-group input:focus, .form-group textarea:focus { border-color: var(--cyan); outline: none; }
        .btn-submit { display: block; width: 100%; background: var(--gold); color: #000; font-weight: bold; text-align: center; padding: 1rem; border-radius: 8px; border: none; font-size: 1.1rem; cursor: pointer; text-transform: uppercase; box-shadow: 0 4px 15px rgba(250,204,21,0.3); }

        /* Footer */
        footer { background: #05070f; text-align: center; padding: 3rem 0; color: #64748b; font-size: 0.9rem; border-top: 1px solid #131c2e; }

        @media (max-width: 768px) {
            .hero h1 { font-size: 2rem; }
            nav { justify-content: center; width: 100%; margin-top: 1rem; }
            .nav-box { justify-content: center; text-align: center; }
        }
    </style>
</head>
<body>

    <header>
        <div class="container nav-box">
            <a href="#" class="logo">⚡ PERMUTALIBRE</a>
            <nav>
                <a href="#soluciones">Soluciones</a>
                <a href="#manifiesto">Por qué elegirnos</a>
                <a href="#registro">Registrar Bien</a>
            </nav>
        </div>
    </header>

    <main class="container">
        
        <!-- Bloque Principal -->
        <section class="hero">
            <span class="badge"><i class="fa-solid fa-shield-halved"></i> Negociación Blindada & RWA</span>
            <h1>No lo vendas, cámbialo</h1>
            <p>Convertimos tus activos digitales en patrimonio tangible. Liquidación en efectivo físico, pasarelas internacionales de envío y permutas inmobiliarias directas respaldadas por intermediación bancaria de alto nivel.</p>
        </section>

        <!-- Secciones de Negocio Físico y RWA -->
        <section id="soluciones" class="services-grid">
            <div class="card">
                <i class="fa-solid fa-money-bill-wave"></i>
                <h3>Efectivo Físico vs Cripto</h3>
                <p>Olvídate de transferencias rastreables y bloqueos preventivos. Liquidamos tus USDT directamente en efectivo con una tasa neta y transparente de <strong>${Math.round(effectiveRate).toLocaleString('es-CO')} COP</strong> por dólar.</p>
            </div>
            <div class="card">
