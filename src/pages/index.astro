---
// LÓGICA DE NEGOCIO: Extracción de tasas base oculta en el servidor
let rawRate = 3950; 
try {
  const response = await fetch('https://binance.com');
  const data = await response.json();
  if (data.price) rawRate = parseFloat(data.price);
} catch (e) {}

// Comisión real del 2.5% ($50.000 COP por cada $2.000.000 COP)
const feePercent = 2.5;
const effectiveRate = rawRate - (rawRate * (feePercent / 100));
