---
// Código de Astro: Aquí definimos los precios base para Colombia en este 2026
const cryptoPrices = [
  { name: 'Bitcoin', ticker: 'BTC', price: '$42.500.000', change: '+2.5%' },
  { name: 'Ethereum', ticker: 'ETH', price: '$2.200.000', change: '+1.8%' },
  { name: 'Tether', ticker: 'USDT', price: '$4.250', change: '0.0%' },
  { name: 'Solana', ticker: 'SOL', price: '$350.000', change: '+4.2%' }
];
---
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Permutalibre - Intercambio Crypto Colombia</title>
</head>
<body style="margin:0; font-family:sans-serif; background:linear-gradient(135deg, #0a1e2e 0%, #0f3460 100%); color:#ecf0f1; min-height:100vh;">

    <!-- Barra de Navegación -->
    <header style="background:rgba(22, 33, 62, 0.9); border-bottom: 2px solid #00d4ff; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; backdrop-filter: blur(10px);">
        <a href="#" style="font-size: 1.5rem; font-weight: bold; color: #00d4ff; text-decoration: none;">⚡ Permutalibre</a>
        <nav style="display: flex; gap: 1.5rem;">
            <a href="#" style="color:#ecf0f1; text-decoration:none;">Inicio</a>
            <a href="#" style="color:#ecf0f1; text-decoration:none;">Precios</a>
            <a href="#" style="color:#ecf0f1; text-decoration:none;">Contacto</a>
        </nav>
    </header>

    <!-- Sección Principal -->
    <main style="max-width: 1200px; margin: 0 auto; padding: 3rem 2rem; text-align: center;">
        <h1 style="font-size: 3.5rem; background: linear-gradient(135deg, #00d4ff, #00ff88); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 1rem;">
            Cambia Cripto por Pesos Colombianos
        </h1>
        <p style="color: #bdc3c7; font-size: 1.2rem; max-width: 600px; margin: 0 auto 3rem auto;">
            La plataforma más rápida, segura y transparente para operar en Colombia sin intermediarios molestos.
        </p>

        <!-- Tabla de Precios en Vivo usando los bloques de Astro -->
        <h2 style="color: #00d4ff; margin-bottom: 1.5rem; text-align: left; max-width: 800px; margin-left: auto; margin-right: auto;">Precios de Referencia (COP)</h2>
        <div style="background: #16213e; border: 1px solid rgba(0, 212, 255, 0.2); border-radius: 12px; max-width: 800px; margin: 0 auto 3rem auto; overflow: hidden; box-shadow: 0 0 30px rgba(0,212,255,0.1);">
            <table style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead>
                    <tr style="background: rgba(0, 212, 255, 0.1); color: #00d4ff;">
                        <th style="padding: 1rem;">Moneda</th>
                        <th style="padding: 1rem;">Precio Promedio</th>
                        <th style="padding: 1rem;">Tendencia</th>
                    </tr>
                </thead>
                <tbody>
                    {cryptoPrices.map((crypto) => (
                        <tr style="border-bottom: 1px solid rgba(236, 240, 241, 0.1);">
                            <td style="padding: 1rem; font-weight: bold;">{crypto.name} ({crypto.ticker})</td>
                            <td style="padding: 1rem; color: #00ff88;">{crypto.price} COP</td>
                            <td style="color: {crypto.change.includes('+') ? '#00ff88' : '#ff4757'}; padding: 1rem;">{crypto.change}</td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>

        <a href="#" style="display: inline-block; padding: 0.75rem 2.5rem; font-weight: bold; background: linear-gradient(135deg, #00d4ff, #00ff88); color: #0a1e2e; border-radius: 8px; text-decoration: none; font-size: 1.1rem; box-shadow: 0 0 20px rgba(0,212,255,0.4);">
            Iniciar un Intercambio
        </a>
    </main>

    <!-- Pie de Página -->
    <footer style="background: #0f3460; text-align: center; padding: 2rem; color: #bdc3c7; border-top: 1px solid rgba(0, 212, 255, 0.2); margin-top: 5rem;">
        <p>&copy; 2026 Permutalibre. Operaciones seguras en Colombia.</p>
    </footer>

</body>
</html>
