---
// Configuración de Servidor en Astro: Márgenes de ganancia y valores base en Colombia
const usdBasePrice = 4250; // Tasa promedio del dólar en COP

const cryptos = [
  { name: 'Bitcoin', ticker: 'BTC', usdPrice: 42500, margin: 2.5, icon: '₿' },
  { name: 'Ethereum', ticker: 'ETH', usdPrice: 2200, margin: 2.0, icon: 'Ξ' },
  { name: 'Tether', ticker: 'USDT', usdPrice: 1.0, margin: 1.5, icon: '₮' },
  { name: 'Solana', ticker: 'SOL', usdPrice: 350, margin: 2.2, icon: '◎' }
];

// Cálculo de tarifas en pesos colombianos usando lógica matemática automatizada
const calculateCOP = (usdPrice, margin) => {
  const baseValue = usdPrice * usdBasePrice;
  const priceWithMargin = baseValue - (baseValue * (margin / 100)); // Precio de compra al usuario
  return Math.round(priceWithMargin).toLocaleString('es-CO');
};
