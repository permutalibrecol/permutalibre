    <script>
        // Tasas base de referencia del mercado P2P y cálculo automático con comisión institucional integrada (ej. 2.5% de margen neto)
        const baseRates = {
            cop: { raw: 3950, fee: 2.5, symbol: 'COP', name: 'Colombia (Efectivo)' },
            crc: { raw: 520, fee: 2.5, symbol: 'CRC', name: 'Costa Rica' },
            ves: { raw: 42.5, fee: 3.0, symbol: 'VES', name: 'Venezuela' }
        };

        function getEffectiveRate(currency) {
            const item = baseRates[currency];
            if (!item) return 0;
            const net = item.raw - (item.raw * (item.fee / 100));
            return Math.round(net * 100) / 100;
        }
    </script>

