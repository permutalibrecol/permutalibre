---
// LÓGICA DE SERVIDOR: Conexión dinámica a la API pública de Binance
let usdtToCop = 3800; // Valor de respaldo por si la API falla temporalmente

try {
  const response = await fetch('https://binance.com');
  const data = await response.json();
  if (data.price) {
    usdtToCop = parseFloat(data.price);
  }
} catch (error) {
  console.error("Error consultando la API de Binance, usando precio base.", error);
}

// Tu margen personalizado: Ganar $50,000 por cada $2,000,000 cambiados (Equivale al 2.5%)
const profitMarginPercent = 2.5; 
const clientBuyPrice = usdtToCop - (usdtToCop * (profitMarginPercent / 100));

// Formateadores de moneda colombiana
const formatCOP = (num) => Math.round(num).toLocaleString('es-CO');
---
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Permutalibre | Cambia Cripto por Pesos Colombianos</title>
    
    <!-- SEO Meta Tags para atraer tráfico en Colombia -->
    <meta name="description" content="Intercambia USDT y criptomonedas por pesos colombianos de forma rápida y segura. Liquidación automatizada bajo tasas reales de Binance.">
    <meta name="keywords" content="cambiar usdt colombia, criptomonedas a pesos colombianos, binance cop p2p, permutalibre">
</head>
<body style="margin:0; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background:#0f172a; color:#f8fafc; min-height:100vh;">

    <!-- Barra de Navegación Adaptable -->
    <header style="background:#1e293b; border-bottom:3px solid #facc15; padding:1rem; box-shadow:0 4px 10px rgba(0,0,0,0.2);">
        <div style="max-width:1100px; margin:0 auto; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
            <div style="font-size:1.4rem; font-weight:900; color:#facc15; letter-spacing:0.5px;">⚡ PERMUTALIBRE</div>
            <nav style="display:flex; gap:1.2rem; font-weight:600; font-size:0.95rem;">
                <a href="#calculadora" style="color:#f8fafc; text-decoration:none;">Calculadora</a>
                <a href="https://wa.me" target="_blank" style="color:#4ade80; text-decoration:none;">WhatsApp Vivo</a>
            </nav>
        </div>
    </header>

    <!-- Contenedor Principal -->
    <main style="max-width:1100px; margin:0 auto; padding:2.5rem 1rem; text-align:center;">
        
        <!-- Eslogan con colores corporativos de tu marca (Amarillo/Azul) -->
        <h1 style="font-size:2.5rem; font-weight:800; color:#facc15; line-height:1.2; margin-bottom:1rem; text-transform:uppercase;">
            No lo vendas, cámbialo
        </h1>
        <p style="color:#94a3b8; font-size:1.1rem; max-width:650px; margin:0 auto 3rem auto; line-height:1.5;">
            Tu cotización transparente con la tasa oficial de <strong>Binance Spot</strong> en tiempo real. Retiros directos a cuentas en Colombia sin bloqueos de terceros.
        </p>

        <!-- Bloque de la Calculadora Reactiva Móvil -->
        <section id="calculadora" style="background:#1e293b; border:2px solid #334155; border-radius:16px; padding:2rem 1.5rem; max-width:550px; margin:0 auto; box-shadow:0 10px 25px rgba(0,0,0,0.3);">
            <h2 style="color:#facc15; font-size:1.4rem; margin-top:0; margin-bottom:1.5rem;">📱 Conversor Automatizado USDT / COP</h2>
            
            <!-- Cuadro de Tasas en Vivo -->
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:2rem; background:#0f172a; padding:1rem; border-radius:10px; border:1px solid #334155;">
                <div>
                    <span style="font-size:0.8rem; color:#94a3b8; display:block;">Tasa Binance</span>
                    <strong style="color:#38bdf8; font-size:1.1rem;">${usdtToCop.toLocaleString('es-CO')} COP</strong>
                </div>
                <div>
                    <span style="font-size:0.8rem; color:#94a3b8; display:block;">Tasa de Cambio Neto</span>
                    <strong style="color:#4ade80; font-size:1.1rem;">${formatCOP(clientBuyPrice)} COP</strong>
                </div>
            </div>

            <!-- Interfaz Interactiva Local (Mobile-First) -->
            <div style="text-align:left; margin-bottom:1.5rem;">
                <label style="display:block; font-size:0.9rem; font-weight:600; margin-bottom:0.5rem; color:#cbd5e1;">Cantidad de USDT a entregar:</label>
                <input type="number" id="usdtInput" value="500" placeholder="Ej: 500" style="width:100%; padding:0.8rem; border-radius:8px; border:2px solid #475569; background:#0f172a; color:#fff; font-size:1.1rem; font-weight:bold; box-sizing:border-box;" />
            </div>

            <div style="text-align:left; margin-bottom:2rem; background:#0f172a; padding:1rem; border-radius:8px; border-left:4px solid #4ade80;">
                <span style="font-size:0.85rem; color:#94a3b8; display:block;">Recibes en tu Banco:</span>
                <span id="copResult" style="font-size:1.6rem; font-weight:800; color:#4ade80;">Calculando...</span>
            </div>

            <!-- Botón Transaccional -->
            <a id="whatsappBtn" href="#" target="_blank" style="display:block; background:#4ade80; color:#0f172a; font-weight:bold; text-align:center; padding:1rem; border-radius:8px; text-decoration:none; font-size:1.1rem; box-shadow:0 4px 12px rgba(74,222,128,0.3); transition:transform 0.2s;">
                💸 Solicitar Cambio por WhatsApp
            </a>
        </section>
    </main>

    <!-- Script de Cliente para Cálculos Inmediatos en Celulares sin recargar página -->
    <script define:vars={{ clientBuyPrice }}>
        const usdtInput = document.getElementById('usdtInput');
        const copResult = document.getElementById('copResult');
        const whatsappBtn = document.getElementById('whatsappBtn');

        function updateValues() {
            const usdtAmount = parseFloat(usdtInput.value) || 0;
            const copTotal = usdtAmount * clientBuyPrice;
            
            // Renderizado en pantalla con formato monetario colombiano
            copResult.textContent = '$ ' + Math.round(copTotal).toLocaleString('es-CO') + ' COP';
            
            // Actualización del mensaje personalizado de WhatsApp
            const message = `Hola Permutalibre, deseo cambiar ${usdtAmount} USDT por un valor estimado de $${Math.round(copTotal).toLocaleString('es-CO')} COP bajo las tasas actuales.`;
            whatsappBtn.href = `https://wa.me?text=${encodeURIComponent(message)}`;
        }

        usdtInput.addEventListener('input', updateValues);
        updateValues(); // Ejecución inicial de arranque
    </script>

    <footer style="background:#1e293b; text-align:center; padding:2rem; color:#94a3b8; font-size:0.9rem; border-top:1px solid #334155; margin-top:5rem;">
        <p>&copy; 2026 Permutalibre. Tasas dinámicas con tecnología de infraestructura digital optimizada.</p>
    </footer>
</body>
</html>
